no_gap = []

def calculate_mssd(df, sentiment):
    df = df.sort_values(by='date').copy()
    df['hour_group'] = df['date'].dt.floor('h')  # lowercase 'h' fixes the FutureWarning
    df['n_in_hour'] = df.groupby('hour_group')['hour_group'].transform('count')

    adjusted_dates = []
    for _, group in df.groupby('hour_group', sort=False):
        n = len(group)
        if n == 1:
            adjusted_dates.extend(group['date'])
        else:
            interval = timedelta(seconds=int(3600 / n))
            start_time = group['hour_group'].iloc[0]
            fake_times = [start_time + i * interval for i in range(n)]
            adjusted_dates.extend(fake_times)
    df['adjusted_date'] = adjusted_dates

    df = df.groupby('adjusted_date', as_index=False)[sentiment].mean()
    df = df.rename(columns={'adjusted_date': 'date'})

    df['time_diff'] = df['date'].diff()
    df['time_diff_float'] = df['time_diff'].dt.days * 24 + df['time_diff'].dt.seconds / 3600

    gap = len(df.loc[df['time_diff_float'] == 0.0])
    no_gap.append(gap)
    df['time_diff_float'] = df['time_diff_float'].replace(0.0, 0.01)

    df['consecutive_sentiments_diff'] = ((df[sentiment] - df[sentiment].shift(1))**2) / df['time_diff_float']

    if len(df) > 1:
        median_time_diff = df['time_diff_float'].median()
        mssd_time_adjusted = df['consecutive_sentiments_diff'].sum() * (median_time_diff / (len(df) - 1))
    else:
        mssd_time_adjusted = np.nan

    # Return BOTH for debugging
    return mssd_time_adjusted, df

def apply_mssd(var, col_name, list_sent, data, debug=False):
    """
    Calculate MSSD for each participant and append results to list_sent.
    If debug=True, also return a dict of adjusted timestamps for inspection.
    """
    debug_data = {}

    for participant_id in data['linker'].unique():
        participant_data = data[data['linker'] == participant_id]

        try:
            result = calculate_mssd(participant_data, var)
            # Handle both possible return types (float or tuple)
            if isinstance(result, tuple):
                mssd, df_adj = result
                if debug:
                    debug_data[participant_id] = df_adj
            else:
                mssd = result

            list_sent.append({'linker': participant_id, col_name: mssd})

        except Exception as e:
            print(f"⚠️ Error processing participant {participant_id} for {var}: {e}")
            list_sent.append({'linker': participant_id, col_name: np.nan})

    if debug:
        return debug_data


def mssd_to_df(data, Q, debug=False):
    """
    Compute MSSD scores for all sentiment measures for a given dataset.
    Returns: DataFrame (and optionally debug info with adjusted timestamps)
    """
    duplicates_mask = data.duplicated(subset='linker', keep=False)
    data = data[duplicates_mask]

    if len(data) == 0:
        print("No valid Tweets")
        return None

    debug_all = {}

    mssd_scores_rb = []
    dbg = apply_mssd('rbcompound', 'RB MSSD', mssd_scores_rb, data, debug=debug)
    if debug: debug_all['rbcompound'] = dbg

    mssd_scores_liwc = []
    apply_mssd('liwccompound', 'LIWC MSSD', mssd_scores_liwc, data)

    mssd_scores_vader = []
    apply_mssd('epicosmvadercompound', 'VADER Compound MSSD', mssd_scores_vader, data)

    mssd_scores_vaderp = []
    apply_mssd('epicosmvaderpositive', 'VP MSSD', mssd_scores_vaderp, data)

    mssd_scores_vadern = []
    apply_mssd('epicosmvadernegative', 'VN MSSD', mssd_scores_vadern, data)

    mssd_scores_negemo = []
    apply_mssd('epicosmliwcnegemo', 'Negemo MSSD', mssd_scores_negemo, data)

    mssd_scores_posemo = []
    apply_mssd('epicosmliwcposemo', 'Posemo MSSD', mssd_scores_posemo, data)

    mssd_scores_neg = []
    apply_mssd('rbnegative', 'Negative Prob MSSD', mssd_scores_neg, data)

    mssd_scores_pos = []
    apply_mssd('rbpositive', 'Positive Prob MSSD', mssd_scores_pos, data)

    # Combine all DataFrames
    dfs = [
        pd.DataFrame(mssd_scores_rb),
        pd.DataFrame(mssd_scores_liwc),
        pd.DataFrame(mssd_scores_vader),
        pd.DataFrame(mssd_scores_vaderp),
        pd.DataFrame(mssd_scores_vadern),
        pd.DataFrame(mssd_scores_negemo),
        pd.DataFrame(mssd_scores_posemo),
        pd.DataFrame(mssd_scores_neg),
        pd.DataFrame(mssd_scores_pos)
    ]

    df = dfs[0]
    for d in dfs[1:]:
        df = pd.merge(df, d, on='linker', how='outer')

    df['Q'] = Q

    if debug:
        return df, debug_all
    else:
        return df


