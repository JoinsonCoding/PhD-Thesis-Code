############################################################
#  LOAD REQUIRED PACKAGES
############################################################

library(lme4)
library(ggplot2)
library(dplyr)
library(partR2)


############################################################
#  LOAD AND PREPARE DATA
############################################################

sent_data <- read.csv("C:\\Users\\ta20395\\TD\\Second Harvest Data\\all_sent.csv")

# Convert sex to numeric-coded factor
sent_data$sex[sent_data$sex == "Male"]   <- -1
sent_data$sex[sent_data$sex == "Female"] <-  1
sent_data$sex <- as.factor(sent_data$sex)

# Generation variable coded by questionnaire letter
sent_data$generation[(sent_data$qlet %in% c("A","B"))] <-  1
sent_data$generation[(sent_data$qlet %in% c("M","P"))] <- -1
sent_data$generation <- as.factor(sent_data$generation)

# Check variable conversion
table(sent_data$sex)
table(sent_data$generation)

# Log-transform tweet count for weighting
sent_data$wt <- log1p(sent_data$total_tweets)

# Convert identifiers to character
sent_data$linker <- as.character(sent_data$linker) # participant ID
sent_data$Q      <- as.character(sent_data$Q)      # questionnaire/timepoint


############################################################
#  SMFQ MAIN MIXED EFFECT MODELS — AVERAGE PROPORTION
############################################################

# LIWC Positive
smfq_avp_liwc_pos <- glmer(
  smfq_score ~ Mean.Posemo.Score + sex + generation + (1|linker) + Q,
  data = sent_data, weights = sent_data$wt,
  family = poisson(),
  control = glmerControl(optimizer = "bobyqa")
)
summary(smfq_avp_liwc_pos)
confint(smfq_avp_liwc_pos, method = "Wald")
partR2(smfq_avp_liwc_pos, partvars = c("Mean.Posemo.Score"), data = sent_data, olre = FALSE, R2_type = "marginal")

