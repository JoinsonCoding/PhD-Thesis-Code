############################################################
# INSTALLING PACKAGES
############################################################

library(lme4)         
library(ggplot2)
library(ggeffects)    
library(circular)     
library(dplyr)        
library(partR2)       


############################################################
# READING AND PREPARING DATA
############################################################

# Read the main dataset containing tweet timing and mental health scores
time_data <- read.csv("C:\\Users\\ta20395\\TD\\Second Harvest Data\\all_cs.csv")

# Recoding sex: Male = -1, Female = 1, then convert to factor
time_data$sex[time_data$sex == "Male"]   <- -1
time_data$sex[time_data$sex == "Female"] <- 1
time_data$sex <- as.factor(time_data$sex)

# Define generation (e.g., G0 vs G1) based on qlet indicator and convert to factor
time_data$generation[(time_data$qlet == "A") | (time_data$qlet == "B")] <- 1
time_data$generation[(time_data$qlet == "M") | (time_data$qlet == "P")] <- -1
time_data$generation <- as.factor(time_data$generation)

# Convert circular mean angle (radians) to mean hour on a 24-hour clock
time_data$Mean.Hour <- time_data$Mean.Angle / (2 * pi) * 24

# Define tweet volume weight as log(1 + total tweets)
time_data$wt <- log1p(time_data$total_tweets)

# Ensure grouping / cluster variables are character (for random effects)
time_data$linker <- as.character(time_data$linker)
time_data$Q      <- as.character(time_data$Q)


############################################################
# CREATE OUTCOME-SPECIFIC DATASETS WITH COMPLETE CASES
############################################################

# Keep rows with valid Mean.Hour
time_data      <- time_data[complete.cases(time_data$Mean.Hour), ]

# Subsets with non-missing outcome scores
smfq_time_data <- time_data[complete.cases(time_data$smfq_score), ]
wem_time_data  <- time_data[complete.cases(time_data$wemwbs_score), ]
gad_time_data  <- time_data[complete.cases(time_data$gad_score), ]


############################################################
# SMFQ MODELS – ORIGINAL MEAN.HOUR VARIABLE
############################################################

# 1) SMFQ model with time-of-day terms interacting with sex and generation
smfq_all_int <- glmer(
  smfq_score ~ 
    # First harmonic (24 h) by sex
    cos(Mean.Hour / 24 * 2 * pi) * sex +
    sin(Mean.Hour / 24 * 2 * pi) * sex +
    # Second harmonic (12 h) by sex
    cos(2 * (Mean.Hour / 24 * 2 * pi)) * sex +
    sin(2 * (Mean.Hour / 24 * 2 * pi)) * sex +
    # First harmonic by generation
    cos(Mean.Hour / 24 * 2 * pi) * generation +
    sin(Mean.Hour / 24 * 2 * pi) * generation +
    # Second harmonic by generation
    cos(2 * (Mean.Hour / 24 * 2 * pi)) * generation +
    sin(2 * (Mean.Hour / 24 * 2 * pi)) * generation +
    # Random intercepts for individual and questionnaire wave
    (1 | linker) + (1 | Q),
  data    = smfq_time_data,
  weights = smfq_time_data$wt,
  family  = poisson(),
  glmerControl(optimizer = c("bobyqa"))
)

# Model summary
summary(smfq_all_int)

# Semi-partial R2 for groups of time terms (by harmonic and sine/cosine, including interactions)
a <- partR2(
  smfq_all_int,
  partbatch = list(
    cosx  = c("cos(Mean.Hour/24 * 2 * pi)", 
              "cos(Mean.Hour/24 * 2 * pi):sex", 
              "cos(Mean.Hour/24 * 2 * pi):generation"),
    sinx  = c("sin(Mean.Hour/24 * 2 * pi)", 
              "sin(Mean.Hour/24 * 2 * pi):sex", 
              "sin(Mean.Hour/24 * 2 * pi):generation"),
    cos2x = c("cos(2 * (Mean.Hour/24 * 2 * pi))", 
              "cos(2 * (Mean.Hour/24 * 2 * pi)):sex", 
              "cos(2 * (Mean.Hour/24 * 2 * pi)):generation"),
    sin2x = c("sin(2 * (Mean.Hour/24 * 2 * pi))", 
              "sin(2 * (Mean.Hour/24 * 2 * pi)):sex", 
              "sin(2 * (Mean.Hour/24 * 2 * pi)):generation")
  ),
  data     = smfq_time_data,
  olre     = FALSE,
  R2_type  = "marginal",
  nboot    = 10
)

# Print marginal R2 for all defined term batches
print(a$R2, n = 100)

# Conditional R2 including random effects contribution
partR2(
  smfq_all_int,
  data      = smfq_time_data,
  olre      = FALSE,
  max_level = 1,
  R2_type   = "conditional"
)


