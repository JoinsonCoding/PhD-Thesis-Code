# Read per-tweet circular datasets for each questionnaire wave
time_c1 <- read.csv("C:\\Users\\ta20395\\TD\\Second Harvest Data\\circ_c1.csv")
time_c2 <- read.csv("C:\\Users\\ta20395\\TD\\Second Harvest Data\\circ_c2.csv")
