time_c6 <- read.csv("C:\\Users\\ta20395\\TD\\Second Harvest Data\\circ_c6.csv")

# Helper function:
# - convert tweet_hour to radians
# - compute circular summaries by linker
# - convert circular medians back to clock time in hours
# - add Q label indicating wave
process_time_data <- function(data, Q_value) {
  data %>%
    mutate(
      # Convert hour-of-day to angle in radians
      tweet_angle = tweet_hour / 24 * (2 * pi)
    ) %>%
    group_by(linker) %>%
    summarise(
      median_hour = median.circular(
        circular(tweet_angle, units = "radians", zero = circular(0), rotation = "counter")
      ),
      median_HL = medianHL.circular(
        circular(tweet_angle, units = "radians", zero = circular(0), rotation = "counter"),
        method = "HL2"
      ),
      var  = angular.variance(
        circular(tweet_angle, units = "radians", zero = circular(0), rotation = "counter")
      ),
      sd   = sd.circular(
        circular(tweet_angle, units = "radians", zero = circular(0), rotation = "counter")
      ),
      Rbar = rho.circular(
        circular(tweet_angle, units = "radians", zero = circular(0), rotation = "counter")
      ),
      Rbar2 = trigonometric.moment(
        circular(tweet_angle, units = "radians", zero = circular(0), rotation = "counter"),
        p = 2
      )$rho,
      # Circular concentration estimator
      delhat = (1 - Rbar2) / (2 * Rbar^2)
    ) %>%
    mutate(
      # Wrap circular medians into [0, 2π)
      median_hour = ifelse(median_hour < 0, median_hour + 2 * pi, median_hour),
      median_HL   = ifelse(median_HL   < 0, median_HL   + 2 * pi, median_HL),
      # Convert circular medians back to hours [0, 24)
      median_hour = (median_hour / (2 * pi)) * 24,
      median_HL   = (median_HL   / (2 * pi)) * 24,
      # Add questionnaire wave identifier
      Q = Q_value
    )
}

# Apply function to each wave and stack into one result
result_all <- bind_rows(
