###############################################
### CIRCULAR STATISTICAL TESTS (Pewsey, 2013)
###############################################

# ------------------------------------------------
# Common Distribution Test: Compute Cosine/Sine Scores
# ------------------------------------------------
CosSinUniScores <- function(cdat) {
  N <- length(cdat)
  ranks <- rank(cdat, ties.method = "random")
  list(
    cos(ranks * 2 * pi / N),
    sin(ranks * 2 * pi / N)
  )
}

# ------------------------------------------------
# Compute Wg Statistic for Group Differences in Distribution
# ------------------------------------------------
WgVal <- function(CSUScores, ndat, g) {
  CosUScores <- CSUScores[[1]]
  SinUScores <- CSUScores[[2]]
  N <- length(CosUScores)
  ndatcsum <- cumsum(ndat)
  
  Wg <- 0
  for (k in 1:g) {
    low <- ifelse(k == 1, 0, ndatcsum[k - 1])
    idx <- (low + 1):(low + ndat[k])
    
    sumCkSq <- (sum(CosUScores[idx]))^2
    sumSkSq <- (sum(SinUScores[idx]))^2
    
    Wg <- Wg + (sumCkSq + sumSkSq) / ndat[k]
  }
  2 * Wg
}

# ------------------------------------------------
# Common Mean Direction Test (Yg Statistic)
# ------------------------------------------------
YgVal <- function(cdat, ndat, g) {
  N <- length(cdat)
  ndatcsum <- cumsum(ndat)
  
  delhat <- numeric(g)
  tbar <- numeric(g)
  
  for (k in 1:g) {
    low <- ifelse(k == 1, 0, ndatcsum[k - 1])
    sample <- circular(cdat[(low + 1):(low + ndat[k])])
    
    tm1 <- trigonometric.moment(sample, p = 1)
    tm2 <- trigonometric.moment(sample, p = 2)
    
    Rbar1 <- tm1$rho
    Rbar2 <- tm2$rho
    tbar[k] <- tm1$mu
    delhat[k] <- (1 - Rbar2) / (2 * Rbar1^2)
  }
  
  # Use stable or unstable version of estimator depending on ratio
  if (max(delhat) / min(delhat) <= 4) {
    CP <- sum(ndat * cos(tbar))
    SP <- sum(ndat * sin(tbar))
    RP <- sqrt(CP^2 + SP^2)
    
    dhat0 <- sum(ndat * delhat) / N
    return(2 * (N - RP) / dhat0)
    
  } else {
    CM <- sum((ndat * cos(tbar)) / delhat)
    SM <- sum((ndat * sin(tbar)) / delhat)
    Yg <- sum(ndat / delhat)
    RM <- sqrt(CM^2 + SM^2)
    
    return(2 * (Yg - RM))
  }
}


