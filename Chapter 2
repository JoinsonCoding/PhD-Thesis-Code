### --- Timing of Tweet Posting --- ###


male   <- subset(main_data, sex == "Male")
female <- subset(main_data, sex == "Female")

m <- circular(male$Mean.Angle)
f <- circular(female$Mean.Angle)

(mean.circular(m) + 2 * pi) / (2 * pi) * 24
sd.circular(m)

(mean.circular(f) + 2 * pi) / (2 * pi) * 24
sd.circular(f)

# Combined dataset
cdat <- c(m, f)
ndat <- c(length(m), length(f))
g <- 2

# Common distribution test
CSUScores <- CosSinUniScores(cdat)
WgObs <- WgVal(CSUScores, ndat, g)
pchisq(WgObs, df = 2 * (g - 1), lower.tail = FALSE)

# Common mean direction test
YgObs <- YgVal(cdat, ndat, g)
pchisq(YgObs, df = g - 1, lower.tail = FALSE)

# Convert mean angle → clock hour
main_data$Mean.Hour <- main_data$Mean.Angle / (2 * pi) * 24

sex_ma <- ggplot(main_data, aes(x = Mean.Hour, color = sex)) +
  geom_density(linewidth = 1.2, fill = NA) +
